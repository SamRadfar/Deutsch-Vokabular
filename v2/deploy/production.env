# Deutsch Vokabular V2 — PRODUCTION build configuration (Firebase project deutsch-vokabular).
# Public Firebase web-app identifiers only: they are visible in every browser by design. Security comes
# from Firebase Auth, Firestore Security Rules and backend authorization (docs/PRODUCTION.md).
# Read ONLY by scripts/build-production.mjs (Vite never loads this path; .env.local is never used for production).
# Never put secrets here (keys of paid services, service-account keys, tokens).
VITE_FIREBASE_ENV=production
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=AIzaSyCjNlqqr5g-InaaEqQUKg7fe3ahkpYCgPI
VITE_FIREBASE_AUTH_DOMAIN=deutsch-vokabular.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=deutsch-vokabular
VITE_FIREBASE_APP_ID=1:910402765205:web:7888798ae4faf143c4f69c
VITE_FIREBASE_MESSAGING_SENDER_ID=910402765205
VITE_FIREBASE_STORAGE_BUCKET=deutsch-vokabular.firebasestorage.app
# Same-origin Google sign-in on the web.app hosts (needed by iPhone Safari, see docs/PRODUCTION.md §8).
# Switch to true ONLY after https://<host>/__/auth/handler of every serving host is an authorized
# redirect URI of the Google OAuth client (otherwise sign-in fails with redirect_uri_mismatch).
VITE_FIREBASE_SAME_ORIGIN_AUTH=false
# Personal vocabulary cloud sync (the customWords rules are part of the deployed production rules).
VITE_PERSONAL_WORDS_SYNC=true
# AI worker (v2/ai-worker) on the owner's Cloudflare account: Workers AI, free allocation, no API key.
# Public URL (not a secret); the worker checks Firebase ID tokens, exact origins and daily limits.
VITE_AI_ENDPOINT=https://deutsch-vokabular-ai.sfr-arian.workers.dev
