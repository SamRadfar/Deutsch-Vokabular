{
  "name": "deutsch-vokabular-v2",
  "version": "0.2.0",
  "private": true,
  "description": "Deutsch Vokabular 2.0 — React + TypeScript development preview (not deployed).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:generate": "node scripts/generate-content.mjs",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-deutsch-vokabular \"vitest run --config vitest.emulator.config.ts\"",
    "test:emulator:proposed": "firebase emulators:exec --only firestore --project demo-deutsch-vokabular \"node scripts/test-proposed-rules.mjs\"",
    "test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-deutsch-vokabular \"playwright test -c playwright.emulator.config.ts\"",
    "rules:deploy:dev": "node scripts/deploy-rules.mjs"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
