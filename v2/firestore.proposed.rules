rules_version = '2';

// Deutsch Vokabular 2.0 — PROPOSED rules (Phase 5A): the deployed rules (firestore.rules) plus
// users/{uid}/customWords/{wordId} for syncing personal vocabulary.
//
// STATUS: PROPOSAL ONLY — tested on the emulator, NOT deployed, needs product-owner approval.
// The deploy script and firebase.json only ever use firestore.rules; to adopt this proposal its
// content is copied into firestore.rules in a reviewed change and deployed with the guarded script.
//
// Target: ONLY the separate v2 Firebase project(s) — currently deutsch-vokabular-v2-dev.
// Deploy only via `npm run rules:deploy:dev` (allowlisted target, emulator tests, double
// confirmation). NEVER deploy this file to the legacy project (deutsch-wortschatz-c7a11): a rules
// deploy replaces ALL rules of a project and would break the legacy app's syncCodes sync.
//
// Principles: deny by default; a signed-in user can read/write only users/{their uid}/…;
// documents are schema-validated; timestamps must be server time; nothing can be deleted
// from the client; migration records are create-only.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isWordId(id) { return id.matches('^dv_[0-9a-f]{10}$'); }
    function boundedString(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function nullableString(v, max) { return v == null || (v is string && v.size() <= max); }
    function smallCount(v) { return v is int && v >= 0 && v <= 100000; }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if false;

      function validUser(d) {
        return d.keys().hasOnly(['schemaVersion', 'profile', 'preferences', 'updatedAt'])
          && d.schemaVersion == 1
          && d.updatedAt == request.time
          && (!('profile' in d) || (
                d.profile is map
                && d.profile.keys().hasOnly(['displayName', 'photoURL'])
                && nullableString(d.profile.get('displayName', null), 200)
                && nullableString(d.profile.get('photoURL', null), 2000)))
          && (!('preferences' in d) || (
                d.preferences is map
                && d.preferences.keys().hasOnly(['theme'])
                && (!('theme' in d.preferences) || d.preferences.theme in ['light', 'dark'])));
      }

      // One document per built-in vocabulary entry the user has touched.
      match /progress/{wordId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProgress(wordId, request.resource.data);
        allow delete: if false; // "not learned" is stored as learned == false (keeps LWW order)
      }

      function validProgress(wordId, d) {
        let fields = ['schemaVersion', 'wordId', 'learned', 'updatedAt', 'clientUpdatedAt', 'opId', 'deviceId', 'origin'];
        return isWordId(wordId)
          && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
          && d.schemaVersion == 1
          && d.wordId == wordId
          && d.learned is bool
          && d.updatedAt == request.time
          && d.clientUpdatedAt is int
          && d.clientUpdatedAt >= 0 && d.clientUpdatedAt < 10000000000000 // informational device clock (ms), bounded
          && boundedString(d.opId, 64)
          && boundedString(d.deviceId, 64)
          && d.origin in ['toggle', 'migration'];
      }

      // Personal vocabulary (proposal). One document per personal word; ids "pw_" + 20 hex never
      // collide with built-in ids. Deleting is a tombstone (deleted: true) so other devices learn
      // about it; documents themselves are never removed by clients.
      match /customWords/{wordId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validCustomWord(wordId, request.resource.data);
        allow update: if isOwner(uid) && validCustomWord(wordId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.source == resource.data.source
          && request.resource.data.legacyId == resource.data.legacyId;
        allow delete: if false;
      }

      function validCustomWord(wordId, d) {
        let fields = ['schemaVersion', 'id', 'article', 'lemma', 'type', 'grammar', 'fa', 'example', 'exampleFa',
          'pronunciationFa', 'placement', 'learned', 'deleted', 'source', 'legacyId', 'createdAt', 'clientUpdatedAt',
          'updatedAt', 'opId', 'deviceId'];
        return wordId.matches('^pw_[0-9a-f]{20}$')
          && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
          && d.schemaVersion == 1
          && d.id == wordId
          && (d.article == null || d.article in ['der', 'die', 'das'])
          && boundedString(d.lemma, 120)
          && d.type in ['n', 'v', 'a', 'au', 'x']
          && d.grammar is string && d.grammar.size() <= 200
          && d.fa is string && d.fa.size() <= 200
          && d.example is string && d.example.size() <= 400
          && d.exampleFa is string && d.exampleFa.size() <= 400
          && d.pronunciationFa is string && d.pronunciationFa.size() <= 200
          && (d.placement == null || (d.placement is map
                && d.placement.keys().hasAll(['category', 'subtab']) && d.placement.keys().hasOnly(['category', 'subtab'])
                && boundedString(d.placement.category, 40) && boundedString(d.placement.subtab, 60)))
          && d.learned is bool
          && d.deleted is bool
          && d.source in ['manual', 'legacy-import']
          && (d.legacyId == null || boundedString(d.legacyId, 40))
          && d.createdAt is int && d.createdAt >= 0 && d.createdAt < 10000000000000
          && d.clientUpdatedAt is int && d.clientUpdatedAt >= 0 && d.clientUpdatedAt < 10000000000000
          && d.updatedAt == request.time
          && boundedString(d.opId, 64)
          && boundedString(d.deviceId, 64);
      }

      // Proof that a legacy dataset was imported; id = SHA-256 of the imported input.
      match /migrations/{migrationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validMigration(migrationId, request.resource.data);
        allow update, delete: if false;
      }

      function validMigration(id, d) {
        let fields = ['schemaVersion', 'inputHash', 'source', 'legacyContentCommit', 'contentVersion', 'counts', 'status', 'completedAt'];
        let countFields = ['matchedEntries', 'imported', 'alreadyLearned', 'conflictsSkipped', 'ambiguousKeys', 'orphanedKeys'];
        return id.matches('^[0-9a-f]{64}$')
          && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
          && d.schemaVersion == 1
          && d.inputHash == id
          && d.source in ['same-origin', 'backup-file']
          && boundedString(d.legacyContentCommit, 40)
          && boundedString(d.contentVersion, 20)
          && d.status == 'completed'
          && d.completedAt == request.time
          && d.counts is map
          && d.counts.keys().hasAll(countFields) && d.counts.keys().hasOnly(countFields)
          && smallCount(d.counts.matchedEntries) && smallCount(d.counts.imported)
          && smallCount(d.counts.alreadyLearned) && smallCount(d.counts.conflictsSkipped)
          && smallCount(d.counts.ambiguousKeys) && smallCount(d.counts.orphanedKeys);
      }
    }

    // Everything else (including the legacy syncCodes collection) is denied by THIS file.
  }
}
