# Deutsch Vokabular 2.0 — Firebase client configuration (copy to .env.local, never commit .env.local)
#
# These are PUBLIC identifiers of a Firebase web app (Firebase Console → Project settings →
# Your apps → Web app → SDK setup and configuration → Config). They are embedded in the
# browser bundle by design. Access control is enforced by Firebase Auth + Firestore rules.
#
# NEVER put here: service-account JSON, private keys, OAuth client secrets, Anthropic keys.
# Without these values the app runs in browse-only mode and shows a diagnostic hint.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Local development against the Firebase Emulator Suite (no real Google account involved).
# Use with a "demo-" project id, e.g. VITE_FIREBASE_PROJECT_ID=demo-deutsch-vokabular.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
