# Deutsch Vokabular 2.0 — Firebase client configuration (copy to .env.local, never commit .env.local)
#
# These are PUBLIC identifiers of a Firebase web app (Firebase Console → Project settings →
# Your apps → Web app → SDK setup and configuration → Config). They are embedded in the
# browser bundle by design. Access control is enforced by Firebase Auth + Firestore rules.
#
# NEVER put here: service-account JSON, private keys, OAuth client secrets, Anthropic keys.
# Without these values the app runs in browse-only mode and shows a diagnostic hint.

# Which environment this configuration belongs to: development | emulator (production is not
# approved yet). The app refuses inconsistent combinations and the legacy production project.
VITE_FIREBASE_ENV=development
# Project id must mark a development project, e.g. deutsch-vokabular-v2-dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Local development against the Firebase Emulator Suite (no real Google account involved).
# Requires VITE_FIREBASE_ENV=emulator and a "demo-" project id, e.g. demo-deutsch-vokabular.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Cloud sync of personal vocabulary (users/{uid}/customWords). Keep false until the Phase 5A.1
# security rules are deployed to THIS project (docs/PERSONAL_SYNC.md §7); while false, personal
# words stay on the device and their changes are queued. Always on with the emulators.
VITE_PERSONAL_WORDS_SYNC=false

# AI suggestions (Phase 5B, docs/AI_DESIGN.md): URL of OUR AI worker, never an API key. Empty =
# AI controls are off. Local mock worker: `npm run ai:dev` → http://127.0.0.1:8787
VITE_AI_ENDPOINT=
